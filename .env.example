# === CORE ===
NODE_ENV=production
PORT=8080
DB_PATH=./data/app.db

# === NETWORK ===
# Prefix /64 của VPS (lấy từ nhà cung cấp, ví dụ 2001:db8:abcd:1234::/64)
IPV6_PREFIX=2001:db8:xxxx::/64
# IP công khai IPv4 của VPS
PUBLIC_IP=160.187.246.219
# Interface mạng chính (thường eth0 hoặc ens3)
NET_IFACE=eth0
# Dải port dành cho proxy
PROXY_PORT_START=30000
PROXY_PORT_END=40000
# Tổng số IPv6 sinh vào pool
POOL_SIZE=7000
# Thời gian cooldown sau khi thu hồi IP (giây)
COOLDOWN_SECONDS=60

# === PRICING ===
PRICE_PER_IP_HOUR=0.01
PRICE_PER_GB=0.05
# Giá riêng cho billing=traffic (nếu khác PRICE_PER_GB thì set)
PRICE_PER_IP_TRAFFIC_MODE=0.05

# === SECURITY ===
WEBHOOK_SECRET=change_me_strong_secret_min32chars
ADMIN_API_KEY=admin_change_me_strong_key
JWT_SECRET=change_me_jwt_secret

# === CORS ===
CORS_ORIGIN=*

# === LOGGING ===
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# === RATE LIMIT ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
