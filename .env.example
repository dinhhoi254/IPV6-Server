# === CORE ===
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/app.db

# === NETWORK ===
# Prefix /64 cua VPS (lay tu nha cung cap, vi du 2001:db8:abcd:1234::/64)
IPV6_PREFIX=2001:db8:xxxx::/64
# IP cong khai IPv4 cua VPS
PUBLIC_IP=160.187.246.219
# Interface mang chinh (thuong eth0 hoac ens3)
NET_IFACE=eth0
BIND_IP=0.0.0.0
CONFIG_DIR=./configs/3proxy
# Dai port danh cho proxy
PROXY_PORT_START=30000
PROXY_PORT_END=40000
# Tong so IPv6 sinh vao pool
POOL_SIZE=7000
# Thoi gian cooldown sau khi thu hoi IP (giay)
COOLDOWN_SECONDS=60

# === PRICING ===
PRICE_PER_IP_HOUR=0.01
PRICE_PER_GB=0.05
# Gia rieng cho billing=traffic (neu khac PRICE_PER_GB thi set)
PRICE_PER_IP_TRAFFIC_MODE=0.05

# === SECURITY ===
WEBHOOK_SECRET=change_me_strong_secret_min32chars
ADMIN_API_KEY=admin_change_me_strong_key
JWT_SECRET=change_me_jwt_secret

# === CORS ===
CORS_ORIGIN=*

# === LOGGING ===
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# === FLEET (nhieu VPS) ===
# Moi VPS copy file nay thanh .env va dien IPV6_PREFIX + PUBLIC_IP that cua VPS do.
# ADMIN_API_KEY / WEBHOOK_SECRET phai khop voi gia tri ma hoa trong options cua web chinh (cpanel/proxy/config).
# PROXY_PORT_START/END co the khac nhau moi VPS neu chung NAT.
# Sau khi dien xong: npm run init-pool && pm2 start ecosystem.config.js --env production

# === RATE LIMIT ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# === ROTATING POOL HEALTH ===
# Tu dong loai IPv6 timeout/cham khoi pool xoay, sau do bu IP available vao lai pool.
ROTATING_HEALTH_ENABLED=1
ROTATING_HEALTH_CONCURRENCY=50
ROTATING_HEALTH_TIMEOUT_MS=5000
ROTATING_HEALTH_MAX_LATENCY_MS=1200
ROTATING_HEALTH_INTERVAL_MS=900000
ROTATING_HEALTH_INITIAL_DELAY_MS=30000
ROTATING_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace
ROTATING_POOL_CHILD_SHARD_SIZE=500
